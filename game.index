<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>사다리꼴 대탐험</title>
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff3d6;--card:#fff;--ink:#2b2d42;--mut:#6b6f85;--paper:#fff8db;--ln:#f0d9a0;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1d1b2e;--card:#2a2744;--ink:#f1efff;--mut:#b4b0d6;--paper:#37325c;--ln:#4b4678;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#1d1b2e;--card:#2a2744;--ink:#f1efff;--mut:#b4b0d6;--paper:#37325c;--ln:#4b4678;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;font-family:"Jua","Noto Sans KR",system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:18px}
header{background:linear-gradient(90deg,#ff6b6b,#ffa94d,#fcc419);color:#fff;padding:12px 16px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;text-shadow:0 2px 0 rgba(0,0,0,.2)}
h1{margin:0;font-size:28px}.sb{background:rgba(0,0,0,.25);padding:6px 14px;border-radius:99px}
nav{display:flex;flex-wrap:wrap;gap:6px;padding:10px}
button{font:inherit;cursor:pointer;border:0;border-radius:99px;padding:8px 14px;background:var(--card);color:var(--ink);box-shadow:0 3px 0 var(--ln)}
nav .on,.bar #ck,.ops button:hover{background:#ff6b6b;color:#fff}
main{max-width:900px;margin:0 auto;padding:10px 14px 40px}
h2{margin:6px 0}.qt{background:var(--card);padding:10px 14px;border-radius:14px;border-left:8px solid #ff922b}
.bx{background:var(--card);padding:12px 16px;border-radius:14px;line-height:1.7;margin-bottom:10px}
.bar{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}.bar #nx{background:#339af0;color:#fff}
#fb{min-height:28px;padding:8px 12px;border-radius:12px;margin:0}#fb.ok{background:#d3f9d8;color:#087f5b}#fb.no{background:#ffe3e3;color:#c92a2a}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:10px 0}
.cd{background:var(--card);border-radius:14px;padding:6px;text-align:center;border:4px solid transparent;cursor:pointer}.cd.on{border-color:#ff6b6b}.cd.good{border-color:#40c057}.cd.bad{border-color:#fa5252}
.cd svg{width:100%;height:auto}
svg.sv{width:100%;height:auto;background:var(--paper);border-radius:16px;touch-action:manipulation}
svg text{fill:var(--ink);font-size:20px;font-weight:700;font-family:inherit}
.pl{stroke:#4c6ef5;stroke-width:5}.sg{stroke:#e8590c;stroke-width:4}
.ops{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}.ops button{font-size:20px;padding:10px 20px}
.pc{cursor:pointer}.pc circle{display:none;fill:none;stroke:#e03131;stroke-width:4}.pc.on circle{display:block}.pc polygon{fill:#fba94c;stroke:#fff;stroke-width:2}
.sw{width:30px;height:30px;padding:0;border:3px solid var(--card)}.sw.on{border-color:var(--ink)}
.tl{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:6px 0}
i{position:fixed;top:-30px;font-style:normal;font-size:26px;animation:fl 1.6s ease-in forwards;pointer-events:none;z-index:9}
@keyframes fl{to{transform:translateY(110vh) rotate(360deg)}}
</style></head><body>
<header><h1>🪜 사다리꼴 대탐험</h1><div class="sb">⭐ 점수 <b id="sc">0</b> · 🔥 연속 <b id="st">0</b></div></header>
<nav id="nv"></nav><main id="g"></main>
<script>
const $=s=>document.querySelector(s),R=(a,b)=>a+Math.floor(Math.random()*(b-a+1)),pick=a=>a[R(0,a.length-1)],shuf=a=>a.map(x=>[Math.random(),x]).sort((p,q)=>p[0]-q[0]).map(x=>x[1]);
const G=$('#g'),N=['가','나','다','라','마','바'],NS=['ㄱ','ㄴ','ㄷ','ㄹ','ㅁ'],COL=['#ffa94d','#74c0fc','#8ce99a','#ffa8a8','#d0bfff','#ffe066'];
let sc=0,st=0;
const up=()=>{$('#sc').textContent=sc;$('#st').textContent=st};
function burst(){for(let i=0;i<16;i++){const s=document.createElement('i');s.textContent=pick(['⭐','🎉','✨','🔶','🟧']);s.style.left=R(3,95)+'vw';s.style.animationDelay=R(0,300)+'ms';document.body.append(s);setTimeout(()=>s.remove(),2000)}}
function fb(g,m){const e=$('#fb');if(g&&!fb.d){fb.d=1;sc+=10+Math.min(st,5)*2;st++;burst()}else if(!g)st=0;up();e.className=g?'ok':'no';e.textContent=(g?'🎉 ':'🤔 ')+m}
function frame(t,body,ck,nx){fb.d=0;G.innerHTML=`<h2>${t}</h2>${body}<div class="bar">${ck?'<button id="ck">확인 ✅</button>':''}<button id="nx">다음 문제 ▶</button></div><p id="fb"></p>`;if(ck)$('#ck').onclick=ck;$('#nx').onclick=nx}
const NV=[['📖','개념',home],['📏','거리재기',dist],['🔍','사다리꼴 고르기',pickT],['✂️','종이띠 자르기',strip],['✏️','점종이에 그리기',()=>dotG('free')],['🔶','도형판 옮겨 그리기',()=>dotG('copy')],['📐','선분으로 완성',()=>dotG('seg')],['📍','꼭짓점 찾기',fourth],['🎨','그림 그리기',art],['🏆','퀴즈',quiz]];
$('#nv').innerHTML=NV.map((n,i)=>`<button data-i="${i}">${n[0]} ${n[1]}</button>`).join('');
$('#nv').onclick=e=>{const b=e.target.closest('button');if(b)go(+b.dataset.i)};
function go(i){[...$('#nv').children].forEach((b,j)=>b.classList.toggle('on',i==j));NV[i][2]()}
/* 기하 도우미 */
const cr=(a,b)=>a[0]*b[1]-a[1]*b[0],dt=(a,b)=>a[0]*b[0]+a[1]*b[1];
const vecs=p=>p.map((a,i)=>{const b=p[(i+1)%p.length];return[b[0]-a[0],b[1]-a[1]]});
const sub=(a,b)=>[b[0]-a[0],b[1]-a[1]],sg=(p,q,r)=>Math.sign(cr(sub(p,q),sub(p,r)));
const X=(a,b,c,d)=>sg(a,b,c)*sg(a,b,d)<0&&sg(c,d,a)*sg(c,d,b)<0;
function ana(p){const v=vecs(p),ar=p.reduce((s,a,i)=>s+cr(a,p[(i+1)%4]),0);
 if(!ar||v.some((x,i)=>!cr(x,v[(i+1)%4]))||X(p[0],p[1],p[2],p[3])||X(p[1],p[2],p[3],p[0]))return null;
 const a=!cr(v[0],v[2]),b=!cr(v[1],v[3]);
 return{a,b,trap:a||b,strict:a!=b,para:a&&b,right:v.some((x,i)=>!dt(x,v[(i+1)%4])),hv:v.some(x=>!x[0]||!x[1]),area:Math.abs(ar)/2,L:new Set(v.map(x=>x[0]*x[0]+x[1]*x[1])).size,hp:(a&&!v[0][1])||(b&&!v[1][1]),vp:(a&&!v[0][0])||(b&&!v[1][0])}}
const eq=(A,B)=>A.some((_,k)=>A.every((v,i)=>{const w=B[(i+k)%B.length];return v[0]==w[0]&&v[1]==w[1]}));
const sameShape=(t,p)=>t.length==p.length&&(eq(vecs(t),vecs(p))||eq(vecs(t),vecs(p.slice().reverse())));
function fit(p,w,h,rot=0,pad=14){const c=Math.cos(rot),s=Math.sin(rot),q=p.map(([x,y])=>[x*c-y*s,x*s+y*c]),xs=q.map(a=>a[0]),ys=q.map(a=>a[1]),x0=Math.min(...xs),y0=Math.min(...ys),W=Math.max(...xs)-x0,H=Math.max(...ys)-y0,k=Math.min((w-2*pad)/W,(h-2*pad)/H);return q.map(([x,y])=>[(w-k*W)/2+(x-x0)*k,(h-k*H)/2+(y-y0)*k])}
const pts=q=>q.map(a=>a.map(n=>n.toFixed(1)).join()).join(' ');
const KN={trap:'사다리꼴',para:'평행사변형',rect:'직사각형',rho:'마름모',sq:'정사각형',kite:'연 모양 사각형',gen:'평행한 변이 없는 사각형'};
function mk(k){const a=R(1,2),b=a+R(1,2),h=R(2,3),o=R(0,b-a);
 if(k=='trap')return[[o,0],[o+a,0],[b,h],[0,h]];
 if(k=='para')return[[1,0],[1+b,0],[b,h],[0,h]];
 if(k=='rect'){const w=h+R(1,2);return[[0,0],[w,0],[w,h],[0,h]]}
 if(k=='rho')return[[a,0],[2*a,b],[a,2*b],[0,b]];
 if(k=='sq'){const s=R(2,3);return[[0,0],[s,0],[s,s],[0,s]]}
 if(k=='kite')return[[a,0],[2*a,b],[a,2*b+R(1,2)],[0,b]];
 let p;do{p=[[0,0],[R(3,5),R(0,1)],[R(3,5),R(2,4)],[R(0,1),R(2,4)]]}while(!ana(p)||ana(p).trap);return p}
const sv=(p,i,rot)=>`<svg viewBox="0 0 170 140"><polygon points="${pts(fit(p,170,140,rot))}" fill="${COL[i%6]}" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/></svg>`;
/* 개념 */
function home(){G.innerHTML=`<h2>📖 사다리꼴이란?</h2><div class="bx">평행한 변이 <b>한 쌍이라도</b> 있는 사각형을 <b>사다리꼴</b>이라고 해요.<br>평행한 두 직선 사이에 <b>수직으로</b> 그은 선분의 길이를 <b>평행선 사이의 거리</b>라고 해요.<br>그래서 평행사변형·직사각형·마름모·정사각형도 모두 사다리꼴이랍니다!</div><div class="cards">${Object.keys(KN).map((k,i)=>`<div class="cd">${sv(mk(k),i,0)}<b>${KN[k]}</b><br>${k=='kite'||k=='gen'?'❌ 사다리꼴 아님':'✅ 사다리꼴'}</div>`).join('')}</div><p class="qt">👆 위 탭에서 게임을 골라 시작해요! 문제는 계속 새로 만들어져요. 연속으로 맞히면 🔥 보너스 점수!</p>`}
/* 1. 거리재기 */
function dist(){const d=R(3,7),th=R(-30,30),k=28,y1=180-d*k/2,y2=y1+d*k,num=Math.random()<.4;let g=`<line class="pl" x1="-300" x2="920" y1="${y1}" y2="${y1}"/><line class="pl" x1="-300" x2="920" y1="${y2}" y2="${y2}"/>`,q,ans,ops;
 if(!num){ans=R(0,3);ops=[0,1,2,3];q='평행선 사이의 거리를 나타내는 선분은 어느 것일까요?';for(let i=0;i<4;i++){const x=110+i*130,s=i==ans?0:pick([-1,1])*R(25,70);g+=`<line class="sg" x1="${x}" y1="${y1}" x2="${x+s}" y2="${y2}"/><text x="${x-8}" y="${y1-10}">${N[i]}</text>`}}
 else{ans=d;ops=[d-1,d,d+1,d+2];q='평행선 사이의 거리는 몇 cm일까요? (눈금자를 읽어요)';g+=`<line x1="310" x2="310" y1="${y1}" y2="${y1+(d+2)*k}" stroke="#888" stroke-width="2"/><line class="sg" x1="310" x2="310" y1="${y1}" y2="${y2}"/>`;for(let j=0;j<=d+2;j++)g+=`<line x1="310" x2="330" y1="${y1+j*k}" y2="${y1+j*k}" stroke="#888" stroke-width="2"/><text x="336" y="${y1+j*k+6}" style="font-size:16px">${j}</text>`}
 frame('📏 평행선 사이의 거리재기',`<p class="qt">${q}</p><svg class="sv" viewBox="0 0 620 360"><g transform="rotate(${th} 310 180)">${g}</g></svg><div class="ops">${ops.filter(v=>num?v>0:1).map(v=>`<button data-v="${v}">${num?v+' cm':N[v]}</button>`).join('')}</div>`,0,dist);
 document.querySelector('.ops').onclick=e=>{const v=e.target.dataset.v;if(v==null)return;fb(v==ans,v==ans?'정답! 평행선에 수직인 선분의 길이가 평행선 사이의 거리예요.':'비스듬한 선분은 수직인 선분보다 길어요. 직각으로 만나는 선분을 찾아봐요!')}}
/* 2. 사다리꼴 고르기 */
function pickT(){const ks=shuf(['trap','gen',...shuf(['trap','para','rect','rho','sq','kite','gen']).slice(0,4)]),P=ks.map(k=>({k,p:mk(k)}));P.forEach(o=>o.t=ana(o.p).trap);
 frame('🔍 사다리꼴 골라내기',`<p class="qt">사다리꼴을 모두 찾아 눌러 보세요! (평행한 변이 한 쌍이라도 있으면 사다리꼴)</p><div class="cards">${P.map((o,i)=>`<div class="cd" data-i="${i}">${sv(o.p,i,R(0,359)*Math.PI/180)}<b>${N[i]}</b> <small></small></div>`).join('')}</div>`,()=>{const c=[...document.querySelectorAll('.cd')];let all=1;c.forEach((e,i)=>{const on=e.classList.contains('on'),o=P[i];if(on!=o.t)all=0;e.classList.add(o.t?'good':'bad');e.querySelector('small').textContent=KN[o.k]+(o.t?' ✅':' ❌')});fb(all,all?'모두 찾았어요! 평행한 변이 한 쌍이라도 있으면 사다리꼴이에요.':'초록 테두리가 사다리꼴이에요. 다시 확인해 봐요!')},pickT);
 $('.cards').onclick=e=>{const c=e.target.closest('.cd');if(c&&!c.classList.contains('good')&&!c.classList.contains('bad'))c.classList.toggle('on')}}
/* 3. 종이띠 자르기 */
function strip(){const n=R(4,6),w=600/n,j=Math.floor(w*.35),mkA=()=>Array.from({length:n+1},(_,i)=>i==0?20:i==n?620:20+i*w+R(-j,j)),t=mkA(),b=mkA(),used=[];
 for(let c=0;c<R(1,2);c++){const m=R(1,n-2);if(used.includes(m))continue;used.push(m);const a=Math.random()<.5?t:b;a[m+1]=a[m]}
 const Pc=Array.from({length:n},(_,i)=>{const p=[[t[i],40],[t[i+1],40],[b[i+1],160],[b[i],160]].filter((q,k,A)=>!(k&&q[0]==A[k-1][0]&&q[1]==A[k-1][1])),cx=p.reduce((s,q)=>s+q[0],0)/p.length,cy=100;return{p,cx,cy,t:t[i]!=t[i+1]&&b[i]!=b[i+1]}});
 frame('✂️ 종이띠 잘라 사다리꼴 찾기',`<p class="qt">직사각형 종이띠를 선을 따라 잘랐어요. 잘라 낸 도형 중 사다리꼴을 모두 찾아 동그라미 해 보세요.</p><svg class="sv" viewBox="0 0 640 200">${Pc.map((o,i)=>`<g class="pc" data-i="${i}"><polygon points="${pts(o.p)}"/><circle cx="${o.cx}" cy="${o.cy}" r="26"/><text x="${o.cx-10}" y="${o.cy+7}" style="fill:#000">${N[i]}</text></g>`).join('')}</svg>`,()=>{let all=1;document.querySelectorAll('.pc').forEach((e,i)=>{if(e.classList.contains('on')!=Pc[i].t)all=0});const tri=Pc.map((o,i)=>o.t?'':N[i]).filter(Boolean);fb(all,all?'정답! 윗변과 아랫변이 평행한 사각형은 모두 사다리꼴!'+(tri.length?' ('+tri.join(', ')+'는 삼각형이라 사다리꼴이 아니에요.)':''):'종이띠의 위·아래 변은 평행해요. 사각형인지, 삼각형인지 잘 살펴봐요.')},strip);
 $('.sv').onclick=e=>{const g=e.target.closest('.pc');if(g)g.classList.toggle('on')}}
/* 4~6. 점종이 */
const C=12,Rw=8,S=46,M=30,PX=x=>M+x*S;
const FT=[['사다리꼴을 하나 그려 보세요',a=>a.trap],['평행한 변이 한 쌍만 있는 사다리꼴 (평행사변형은 안 돼요)',a=>a.strict],['평행한 변이 두 쌍인 사다리꼴 (평행사변형)',a=>a.para],['직각이 있는 사다리꼴',a=>a.trap&&a.right],['직각이 없는 사다리꼴',a=>a.trap&&!a.right],['가로·세로 변이 하나도 없는 기울어진 사다리꼴',a=>a.trap&&!a.hv],['직사각형 모양 사다리꼴',a=>a.para&&a.right],['넓이가 8칸 이상인 사다리꼴 (점 사이 한 칸=정사각형 1칸)',a=>a.trap&&a.area>=8],['넓이가 4칸인 사다리꼴',a=>a.trap&&a.area==4],['네 변의 길이가 모두 다른 사다리꼴',a=>a.trap&&a.L==4],['평행한 변이 가로로 놓인 사다리꼴',a=>a.trap&&a.hp],['평행한 변이 세로로 놓인 사다리꼴',a=>a.trap&&a.vp]];
function trapU(){const w1=R(1,2),w2=w1+R(1,2),h=R(1,3),o=R(0,w2-w1);let p=[[o,0],[o+w1,0],[w2,h],[0,h]];if(Math.random()<.5)p=p.map(([x,y])=>[y,x]);if(Math.random()<.5){const m=Math.max(...p.map(q=>q[1]));p=p.map(([x,y])=>[x,m-y])}return p}
function dotG(mode){let P=[],cl=0,T,tg,gv;
 if(mode=='free')T=pick(FT);
 if(mode=='copy')tg=trapU();
 if(mode=='seg'){do{gv=[[R(2,9),R(2,5)]];gv.push([gv[0][0]+R(-3,3),gv[0][1]+R(-3,3)])}while(gv[0][0]==gv[1][0]&&gv[0][1]==gv[1][1])}
 const tt={free:'✏️ 점종이에 사다리꼴 그리기',copy:'🔶 도형판 사다리꼴 점종이에 옮겨 그리기',seg:'📐 주어진 선분으로 사다리꼴 완성하기'}[mode];
 const q={free:T&&T[0],copy:'왼쪽 도형판의 사다리꼴과 똑같은 모양·같은 방향으로 점종이에 옮겨 그려 보세요.',seg:'검은색 선분을 한 변으로 하는 사다리꼴을 완성해 보세요.'}[mode];
 const prev=mode=='copy'?`<svg viewBox="0 0 160 160" style="width:150px;background:#69c07f;border-radius:10px;float:right;margin:0 0 6px 8px">${[0,1,2,3,4].map(y=>[0,1,2,3,4].map(x=>`<circle cx="${20+x*30}" cy="${20+y*30}" r="3" fill="#2b8a3e"/>`).join('')).join('')}<polygon points="${tg.map(p=>(20+p[0]*30)+','+(20+p[1]*30)).join(' ')}" fill="none" stroke="#e03131" stroke-width="4" stroke-linejoin="round"/></svg>`:'';
 const inner=()=>{let o='';if(gv)o+=`<line x1="${PX(gv[0][0])}" y1="${PX(gv[0][1])}" x2="${PX(gv[1][0])}" y2="${PX(gv[1][1])}" stroke="var(--ink)" stroke-width="8" stroke-linecap="round"/>`;
  if(P.length>1)o+=`<${cl?'polygon':'polyline'} points="${P.map(p=>PX(p[0])+','+PX(p[1])).join(' ')}" fill="${cl?'rgba(255,140,0,.35)':'none'}" stroke="#e8590c" stroke-width="5" stroke-linejoin="round"/>`;
  for(let y=0;y<Rw;y++)for(let x=0;x<C;x++){const i=P.findIndex(p=>p[0]==x&&p[1]==y);o+=`<circle cx="${PX(x)}" cy="${PX(y)}" r="${i>=0?11:8}" fill="${i>=0?'#e03131':'#ff7a45'}"/><circle data-x="${x}" data-y="${y}" cx="${PX(x)}" cy="${PX(y)}" r="22" fill="transparent"/>`}return o};
 frame(tt,`<p class="qt">${q}<br><small>점을 차례로 눌러 4개를 잇고, 처음 점을 다시 눌러 닫아요.</small></p>${prev}<svg class="sv" id="sv" viewBox="0 0 ${2*M+(C-1)*S} ${2*M+(Rw-1)*S}">${inner()}</svg><div class="bar"><button id="un">↩️ 되돌리기</button><button id="rs">🗑️ 다시</button></div>`,()=>{
  if(!cl||P.length!=4)return fb(0,'점 4개를 이은 뒤 처음 점을 눌러 닫아 주세요.');
  const a=ana(P);if(!a)return fb(0,'사각형이 아니에요. (선이 겹치거나 한 직선 위에 점이 있어요)');
  if(mode=='free')return fb(T[1](a),T[1](a)?'조건에 딱 맞는 사다리꼴이에요!':a.trap?'사다리꼴은 맞지만 조건과 달라요. 다시 도전!':'평행한 변이 하나도 없어요.');
  if(mode=='copy')return fb(sameShape(tg,P),sameShape(tg,P)?'똑같이 옮겨 그렸어요!':'모양이나 방향이 달라요. 한 칸씩 세어 보세요.');
  const has=P.some((p,i)=>{const n=P[(i+1)%4];return(p[0]==gv[0][0]&&p[1]==gv[0][1]&&n[0]==gv[1][0]&&n[1]==gv[1][1])||(p[0]==gv[1][0]&&p[1]==gv[1][1]&&n[0]==gv[0][0]&&n[1]==gv[0][1])});
  fb(has&&a.trap,!has?'검은 선분이 사각형의 한 변이 아니에요.':a.trap?'멋져요! 사다리꼴 완성!':'평행한 변이 없어요. 한 쌍의 변이 평행하도록 해 보세요.')},()=>dotG(mode));
 const rd=()=>{$('#sv').innerHTML=inner()};
 $('#sv').onclick=e=>{const x=e.target.dataset.x;if(x==null||cl)return;const y=+e.target.dataset.y,i=P.findIndex(p=>p[0]==+x&&p[1]==y);if(i==0&&P.length>=3)cl=1;else if(i<0&&P.length<4)P.push([+x,y]);rd()};
 $('#un').onclick=()=>{if(cl)cl=0;else P.pop();rd()};$('#rs').onclick=()=>{P=[];cl=0;rd()}}
/* 7. 꼭짓점 찾기 */
function fourth(){const px=R(0,2),py=R(6,8),w=R(3,6),h=R(3,5),mx=C-1-px,cand=[],ok=(x,y)=>(y==h&&x>0)||(x==w&&y>0),W=2*M+(C-1)*S,H=2*M+(Rw-1)*S;
 const vs=[],bad=[];for(let x=1;x<=mx;x++)for(let y=1;y<=py;y++){if(x==w&&y==h)continue;(ok(x,y)?vs:bad).push([x,y])}
 const sel=[...shuf(vs).slice(0,R(2,3)),...shuf(bad).slice(0,R(2,3))].slice(0,5);const L=shuf(sel).map((p,i)=>({x:p[0],y:p[1],t:ok(p[0],p[1]),n:NS[i]}));
 const sx=x=>PX(px+x),sy=y=>PX(py-y);
 frame('📍 나머지 꼭짓점 찾기',`<p class="qt">주어진 두 선분을 두 변으로 하는 사다리꼴을 그리려고 해요. 나머지 한 꼭짓점이 될 수 있는 점을 모두 찾아 눌러 보세요.</p><svg class="sv" id="sv" viewBox="0 0 ${W} ${H}">${Array.from({length:C*Rw},(_,i)=>`<circle cx="${PX(i%C)}" cy="${PX(Math.floor(i/C))}" r="3.5" fill="var(--mut)"/>`).join('')}<polyline points="${sx(0)},${sy(h)} ${sx(0)},${sy(0)} ${sx(w)},${sy(0)}" fill="none" stroke="var(--ink)" stroke-width="8" stroke-linejoin="round"/>${L.map((o,i)=>`<g class="pc" data-i="${i}"><circle cx="${sx(o.x)}" cy="${sy(o.y)}" r="15" style="display:block;fill:#ffd43b;stroke:#e8590c"/><text x="${sx(o.x)-8}" y="${sy(o.y)-20}">${o.n}</text></g>`).join('')}</svg>`,()=>{let all=1;const g=[...document.querySelectorAll('.pc')];g.forEach((e,i)=>{const on=e.classList.contains('on');if(on!=L[i].t)all=0;e.querySelector('circle').style.fill=L[i].t?'#69db7c':'#ff8787'});fb(all,all?'정답! 한 변과 평행하도록 반대쪽 꼭짓점을 찍으면 사다리꼴이 돼요.':'초록색이 사다리꼴이 되는 점이에요. 가로선·세로선과 평행하게 맞닿는 점을 찾아봐요.')},fourth);
 $('#sv').onclick=e=>{const g=e.target.closest('.pc');if(g){g.classList.toggle('on');g.querySelector('circle').style.fill=g.classList.contains('on')?'#ff922b':'#ffd43b'}}}
/* 8. 그림 그리기 */
const SH=[[[-1,.5],[1,.5],[.5,-.5],[-.5,-.5]],[[-1,.5],[1,.5],[.3,-.5],[-1,-.5]],[[-.6,1],[.6,1],[.3,-1],[-.3,-1]],[[-1.5,.3],[1.5,.3],[.9,-.3],[-.9,-.3]],[[-1,.5],[.6,.5],[1,-.5],[-.6,-.5]],[[-1,.5],[1,.5],[1,-.5],[-.3,-.5]]];
const PAL=['#e03131','#ff922b','#fcc419','#40c057','#228be6','#7950f2','#f06595','#8d5524','#ffffff','#343a40'];
const DEMO={ship:[[3,310,330,180,2.2,'#8d5524',0],[1,300,235,0,2.6,'#ffffff',0],[1,360,260,0,1.6,'#fcc419',1]],tree:[[2,310,340,0,1.1,'#8d5524',0],[0,310,235,0,2.4,'#2f9e44',0],[0,310,190,0,1.8,'#40c057',0],[0,310,155,0,1.2,'#69db7c',0]]};
function art(){let it=[],sh=0,co=PAL[0],rot=0,sz=1.5,fl=0,bg='#cceeff';
 G.innerHTML=`<h2>🎨 사다리꼴로 그림 그리기</h2><p class="qt">사다리꼴 도장을 골라 그림판을 눌러 찍어요. 사다리꼴을 <b>10개 이상</b> 써서 나만의 그림을 완성해 봐요! (<b id="cn">0</b>개 사용)</p>
 <div class="tl" id="shs">${SH.map((p,i)=>`<button data-s="${i}"><svg width="54" height="40" viewBox="0 0 54 40"><polygon points="${pts(fit(p,54,40,0,4))}" fill="${COL[i]}" stroke="var(--ink)" stroke-width="2"/></svg></button>`).join('')}</div>
 <div class="tl" id="cos">${PAL.map(c=>`<button class="sw" data-c="${c}" style="background:${c}"></button>`).join('')}</div>
 <div class="tl"><button data-a="r-">⟲ 돌리기</button><button data-a="r+">⟳ 돌리기</button><button data-a="s+">➕ 크게</button><button data-a="s-">➖ 작게</button><button data-a="f">⇋ 뒤집기</button><button data-a="u">↩️ 되돌리기</button><button data-a="c">🗑️ 지우기</button></div>
 <div class="tl">예시: <button data-d="ship">🚢 배</button><button data-d="tree">🌲 나무</button> 배경: <button data-b="#cceeff">🌤️</button><button data-b="#2b2f5c">🌙</button><button data-b="#a5d8ff">🌊</button><button data-b="#fff3bf">🏜️</button></div>
 <p id="pv" style="margin:4px 0">현재 도장 → 회전 0° · 크기 1.5</p><svg class="sv" id="cv" viewBox="0 0 620 420" style="background:${bg};cursor:crosshair"></svg>
 <div class="bar"><button id="ck">🌟 그림 완성!</button></div><p id="fb"></p>`;fb.d=0;
 const rd=()=>{$('#cv').innerHTML=it.map(([s,x,y,r,z,c,f])=>`<polygon points="${pts(SH[s].map(a=>[a[0]*30,a[1]*30]))}" transform="translate(${x} ${y}) rotate(${r}) scale(${f?-z:z} ${z})" fill="${c}" stroke="#222" stroke-width="2" vector-effect="non-scaling-stroke"/>`).join('');$('#cn').textContent=it.length;$('#pv').textContent=`현재 도장 → 회전 ${rot}° · 크기 ${sz}${fl?' · 뒤집음':''}`;document.querySelectorAll('#cos .sw').forEach(b=>b.classList.toggle('on',b.dataset.c==co));document.querySelectorAll('#shs button').forEach((b,i)=>b.style.outline=i==sh?'3px solid #ff6b6b':'none')};
 $('#cv').onclick=e=>{const s=$('#cv'),p=s.createSVGPoint();p.x=e.clientX;p.y=e.clientY;const q=p.matrixTransform(s.getScreenCTM().inverse());it.push([sh,Math.round(q.x),Math.round(q.y),rot,sz,co,fl]);rd()};
 G.onclick=e=>{const b=e.target.closest('button');if(!b)return;const d=b.dataset;if(d.s!=null)sh=+d.s;if(d.c)co=d.c;if(d.b)$('#cv').style.background=d.b;if(d.d){it=DEMO[d.d].slice();}
  if(d.a){const a=d.a;if(a=='r-')rot=(rot-15+360)%360;if(a=='r+')rot=(rot+15)%360;if(a=='s+')sz=Math.min(4,+(sz+.3).toFixed(1));if(a=='s-')sz=Math.max(.6,+(sz-.3).toFixed(1));if(a=='f')fl=1-fl;if(a=='u')it.pop();if(a=='c')it=[]}
  if(b.id=='ck'){const n=it.length;fb(n>=10,n>=10?`사다리꼴 ${n}개로 멋진 작품 완성! 친구들에게 자랑해 봐요 🖼️`:`아직 ${10-n}개 더 필요해요. 도장을 더 찍어 보세요!`)}rd()};rd()}
/* 9. 퀴즈 */
const OX=['⭕ 맞다','❌ 아니다'];
const QB=[['사다리꼴의 뜻으로 알맞은 것은?',['평행한 변이 한 쌍이라도 있는 사각형','네 변의 길이가 모두 같은 사각형','네 각이 모두 직각인 사각형','평행한 변이 없는 사각형'],0,'평행한 변이 한 쌍이라도 있으면 사다리꼴이에요.'],
['평행선 사이의 거리는?',['평행선에 수직으로 그은 선분의 길이','가장 긴 선분의 길이','비스듬히 그은 선분의 길이','두 직선의 길이의 합'],0,'수직인 선분이 가장 짧고, 이 길이가 평행선 사이의 거리예요.'],
['직사각형은 사다리꼴이다.',OX,0,'평행한 변이 두 쌍이라 사다리꼴이에요.'],['마름모는 사다리꼴이다.',OX,0,'마주 보는 변이 평행해요.'],['평행사변형은 사다리꼴이다.',OX,0,'평행한 변이 있으니 사다리꼴!'],['정사각형은 사다리꼴이다.',OX,0,'평행한 변이 두 쌍 있어요.'],
['삼각형은 사다리꼴이다.',OX,1,'사다리꼴은 사각형이에요. 삼각형은 아니에요.'],['평행한 변이 하나도 없는 사각형은 사다리꼴이다.',OX,1,'평행한 변이 한 쌍은 있어야 해요.'],
['사다리꼴에는 평행한 변이 적어도 몇 쌍 있을까요?',['1쌍','2쌍','0쌍','3쌍'],0,'적어도 한 쌍은 있어야 사다리꼴이에요.'],
['다음 중 사다리꼴이 아닌 것은?',['평행한 변이 없는 사각형','직사각형','마름모','평행사변형'],0,'평행한 변이 없으면 사다리꼴이 아니에요.'],
['평행선 사이의 거리를 잴 때 쓰기 좋은 도구는?',['삼각자(직각)','컴퍼스','저울','시계'],0,'삼각자의 직각을 이용해 수직선을 그어요.'],
['평행선 사이의 거리가 4 cm일 때 비스듬한 선분의 길이는?',['4 cm보다 길다','4 cm','4 cm보다 짧다','3 cm'],0,'수직이 아닌 선분은 더 길어요.'],
['평행한 두 직선 사이의 거리는 어느 곳에서 재어도 같다.',OX,0,'평행선은 간격이 늘 같아요.'],
['한 직선에 수직인 두 직선은 서로 평행하다.',OX,0,'같은 직선에 수직이면 서로 평행해요.'],
['사다리꼴을 만들려면 점이 최소 몇 개 필요할까요?',['3개','4개','5개','6개'],1,'사각형이니까 꼭짓점이 4개!'],
['직사각형 종이띠를 비스듬히 잘랐을 때 위·아래 변이 있는 사각형 조각은?',['사다리꼴','삼각형','원','오각형'],0,'위·아래 변이 평행하니까 사다리꼴이에요.'],
['사각형 ㄱㄴㄷㄹ에서 변 ㄱㄴ과 변 ㄷㄹ이 평행하다. 이 사각형은?',['사다리꼴','삼각형','오각형','알 수 없다'],0,'평행한 변이 한 쌍 있어요.'],
['평행한 변이 한 쌍만 있는 사각형은 평행사변형이다.',OX,1,'평행한 변이 두 쌍이어야 평행사변형이에요.'],
['사다리꼴이라는 이름은 무엇을 닮아서 붙었을까요?',['사다리','지붕','연','탑'],0,'사다리 모양을 닮았어요 🪜'],
['평행선 사이의 거리가 3 cm이면, 수직 선분의 길이는?',['3 cm','5 cm','1 cm','알 수 없다'],0,'수직 선분의 길이가 곧 거리예요.'],
['직각사다리꼴에 대한 설명으로 알맞은 것은?',['직각이 있는 사다리꼴','평행한 변이 없다','변이 3개이다','모든 변의 길이가 같다'],0,'직각이 있는 사다리꼴이에요.'],
['마름모는 평행한 변이 몇 쌍일까요?',['2쌍','1쌍','0쌍','4쌍'],0,'마주 보는 두 쌍이 모두 평행해요.']];
function quiz(){const Q=shuf(QB).slice(0,10);let i=0,s=0;
 const show=()=>{if(i>=10){G.innerHTML=`<h2>🏆 퀴즈 결과</h2><div class="bx" style="font-size:24px;text-align:center">${s} / 10 점<br>${'⭐'.repeat(Math.ceil(s/2))||'💪'}<br>${s>=9?'사다리꼴 박사!':s>=6?'참 잘했어요!':'다시 도전!'}</div><div class="bar"><button id="nx">🔄 새 퀴즈</button></div>`;$('#nx').onclick=quiz;return}
  const [q,o,a,w]=Q[i],ix=o.map((t,k)=>k);const order=o==OX?ix:shuf(ix);
  frame(`🏆 퀴즈 ${i+1} / 10`,`<p class="qt">${q}</p><div class="ops">${order.map(k=>`<button data-v="${k}">${o[k]}</button>`).join('')}</div>`,0,()=>{i++;show()});
  document.querySelector('.ops').onclick=e=>{const v=e.target.dataset.v;if(v==null||fb.d)return;const r=v==a;if(r){s++;fb(1,'정답! '+w)}else fb(0,'아쉬워요. '+w+' (정답: '+o[a]+')');fb.d=1}};show()}
go(0);
</script></body></html>
